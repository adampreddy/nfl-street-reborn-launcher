{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFL Street Reborn",
  "version": "3.1.0",
  "identifier": "com.nflstreetreborn.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "NFL Street Reborn",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#0B0C0E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https://api.nflstreetreborn.com/live-assets/ https://cdn.discordapp.com/avatars/; font-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
