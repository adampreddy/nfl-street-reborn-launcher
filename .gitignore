# Secrets, never commit
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
credentials.json

# Game data and user-provided content, never commit
*.iso
*.rvz
*.gcm
*.wbfs
*.dol
*.raw
*.nsmp

# Large binary trees
/runtime/
/vendor/dolphin/
**/reshade-shaders/
**/Load/Textures/

# Build output
/target/
/dist/
/build/
/release/
node_modules/
*.exe
# The delta patcher every build ships in <install>\tools: a launcher-only update installed as a
# fresh beta had no game-import\ and so no xdelta3, and game patches never reached the disc (09-26).
!installer/windows/tools-redist/xdelta/xdelta3.exe
*.dll
*.dylib
*.so

# Local state
*.db
*.db-shm
*.db-wal
*.log
.DS_Store
Thumbs.db

# Design and brand assets are the one binary class this repo carries
!docs/design/*.png
!assets/*.png

# Rust
/target/
**/*.rs.bk

# Signing keys from rebornctl publish keygen. Never in the repository.
*.key

# Linux AppImage external binaries (DolphinTool, xdelta3), placed by CI
crates/reborn-ui/binaries/
/target-jammy/

# Design-hook tooling state (impeccable)
.impeccable/
